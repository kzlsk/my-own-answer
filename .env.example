# .env.example 을 .env.local 로 복사한 뒤 값을 채우세요. .env.local 은 git에 올라가지 않습니다.

# OpenAI API 키. 비워 두면 데모 모드로 실행됩니다.
OPENAI_API_KEY=

# 사용할 모델. 비용이 낮은 모델을 권장합니다. (사용 가능한 모델명은 OpenAI 문서에서 확인)
OPENAI_MODEL=gpt-4o-mini

# (선택) 공고 스크린샷을 읽을 모델. 비워 두면 gpt-4o를 씁니다(gpt-4o-mini는 한글 오독이 많음, BUG-007). 이미지 입력을 지원하는 모델이어야 합니다.
# OPENAI_VISION_MODEL=

# (선택) 앱에서 쓸 프롬프트 버전. 비워 두면 평가로 정한 기본값을 씁니다.
# QUESTION_PROMPT_VERSION=v1
# EXPERIENCE_PROMPT_VERSION=v1
# ANSWER_PROMPT_VERSION=v2
# POSTING_OCR_PROMPT_VERSION=v2
# RESUME_STRUCTURE_PROMPT_VERSION=v1
# INTERVIEWER_PROMPT_VERSION=v4
# INTERVIEW_FEEDBACK_PROMPT_VERSION=v1
